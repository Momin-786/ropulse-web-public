# Development includes clearly labelled manual drafts. Public builds default to approved articles only.
DOCS_REVIEW_MODE=false
# Owner-approved: expose all manual chapters with draft labels and noindex.
# Set false to return to approved-articles-only publication.
DOCS_PUBLIC_DRAFTS=true
# Never enable indexing for previews or a review build.
SITE_INDEXABLE=false
SITE_URL=http://localhost:3000
# Set these to approved, real details before public launch.
COMPANY_NAME=Ebosoft Solutions
SUPPORT_EMAIL=support@ropulse.io
SALES_EMAIL=
# HTTPS shared RoPulse identity entry point. No separate website user database.
IDENTITY_URL=
# Server-only delivery destination. It must acknowledge a durable, accepted enquiry.
CONTACT_ENDPOINT=
CONTACT_API_TOKEN=
# Evidence flags: set true only after completing and recording the real checks.
SUPPORT_MAILBOX_VERIFIED=false
DEPENDENCY_SECURITY_VERIFIED=false
DEPLOYMENT_VERIFIED=false
ENQUIRY_DELIVERY_VERIFIED=false
PAID_BACKEND_VERIFIED=false
